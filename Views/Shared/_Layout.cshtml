<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventEase</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    🎪 EventEase
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Venues" asp-action="Index">Venues</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Bookings" asp-action="Index">Bookings</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Hero banner -->
    <section class="hero-banner text-white py-5">
        <div class="container d-md-flex align-items-center justify-content-between">
            <div>
                <h1 class="hero-title">Manage venues, events & bookings</h1>
                <p class="lead hero-sub">Beautiful, simple venue booking. Upload images, prevent double bookings and filter by event type.</p>
                <div class="mt-3">
                    <a asp-controller="Events" asp-action="Create" class="btn btn-primary me-2">Create Event</a>
                    <a asp-controller="Venues" asp-action="Create" class="btn btn-ghost">Add Venue</a>
                </div>
            </div>
            <div class="hero-graphic d-none d-md-block">
                <!-- decorative SVG or illustration placeholder -->
                <svg width="240" height="160" viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="0" y="0" width="240" height="160" rx="12" fill="url(#g)" />
                    <defs>
                        <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#e94560"/>
                            <stop offset="1" stop-color="#16213e"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
        </div>
    </section>

    <div class="container mt-4 reveal-on-scroll">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer reveal-on-scroll">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 - EventEase - Venue Booking System</p>
        </div>
    </footer>

    <!-- Floating action button -->
    <a href="/Events/Create" class="fab" aria-label="Create">
        +
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>